<Project Sdk="Microsoft.NET.Sdk">

  <!-- 0ReworkData: ensamblado SIN dependencias (solo BCL). Nunca se recarga,
       por lo que sirve para pasar estado a través de la barrera del reload.
       Equivalente a Prepatcher Source/DataAssembly (DataStore.cs). -->
  <PropertyGroup>
    <TargetFramework>net472</TargetFramework>
    <LangVersion>10.0</LangVersion>
    <Nullable>enable</Nullable>
    <RootNamespace>Rework.Data</RootNamespace>
    <AssemblyName>0ReworkData</AssemblyName>
    <OutputPath>..\..\Assemblies\</OutputPath>
    <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
    <AppendRuntimeIdentifierToOutputPath>false</AppendRuntimeIdentifierToOutputPath>
  </PropertyGroup>

  <PropertyGroup Condition="'$(Configuration)'=='Release'">
    <DebugType>none</DebugType>
  </PropertyGroup>

</Project>
